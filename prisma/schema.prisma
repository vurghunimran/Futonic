generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN WORKER }
enum WorkStatus { UNASSIGNED ASSIGNED IN_PROGRESS READY_FOR_REVIEW COMPLETED CANCELLED }
enum Priority { LOW MEDIUM HIGH URGENT }
enum AgendaKind { FIXTURE MANUAL }
enum NotificationChannel { IN_APP EMAIL TELEGRAM }
enum DeliveryStatus { PENDING SENT FAILED SKIPPED }

model User {
  id String @id @default(cuid())
  email String? @unique
  name String
  surname String?
  phone String? @unique
  telegramChatId String?
  telegramActivatedAt DateTime?
  telegramActivationToken String? @unique
  passwordHash String?
  role Role @default(ADMIN)
  timezone String @default("Asia/Baku")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favourites Favourite[]
  preferences NotificationPreference?
}

model Worker {
  id String @id @default(cuid())
  fullName String
  email String @unique
  telegramChatId String?
  avatarUrl String?
  active Boolean @default(true)
  role Role @default(WORKER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments Assignment[]
}

model Club {
  id String @id @default(cuid())
  provider String
  externalId String
  name String
  country String?
  logoUrl String?
  homeFixtures Fixture[] @relation("HomeClub")
  awayFixtures Fixture[] @relation("AwayClub")
  @@unique([provider, externalId])
}

model Player {
  id String @id @default(cuid())
  provider String
  externalId String
  name String
  nationality String?
  photoUrl String?
  currentClubId String?
  currentClub Club? @relation(fields: [currentClubId], references: [id])
  @@unique([provider, externalId])
}

model Competition {
  id String @id @default(cuid())
  provider String
  externalId String
  name String
  logoUrl String?
  fixtures Fixture[]
  @@unique([provider, externalId])
}

model Fixture {
  id String @id @default(cuid())
  provider String
  externalId String
  kickoffAt DateTime
  originalTimezone String?
  venue String?
  city String?
  country String?
  round String?
  status String
  sourceUrl String?
  homeClubId String
  awayClubId String
  competitionId String
  homeClub Club @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club @relation("AwayClub", fields: [awayClubId], references: [id])
  competition Competition @relation(fields: [competitionId], references: [id])
  agendaItems AgendaItem[]
  syncedAt DateTime @default(now())
  @@unique([provider, externalId])
  @@index([kickoffAt])
}

model AgendaItem {
  id String @id @default(cuid())
  userId String
  kind AgendaKind
  title String
  startsAt DateTime
  deadlineAt DateTime?
  fixtureId String?
  fixture Fixture? @relation(fields: [fixtureId], references: [id])
  status WorkStatus @default(UNASSIGNED)
  priority Priority @default(MEDIUM)
  client String?
  workType String?
  description String?
  notes String?
  referenceUrl String?
  selectedPlayerId String?
  assignment Assignment?
  assignmentHistory AssignmentHistory[]
  notifications NotificationLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, startsAt])
  @@unique([userId, fixtureId])
}

model Assignment {
  id String @id @default(cuid())
  agendaItemId String @unique
  workerId String
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])
  assignedAt DateTime @default(now())
  @@index([workerId])
}

model AssignmentHistory {
  id String @id @default(cuid())
  agendaItemId String
  workerId String?
  action String
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id])
  createdAt DateTime @default(now())
}

model Favourite {
  id String @id @default(cuid())
  userId String
  entityType String
  provider String
  externalId String
  label String
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, entityType, provider, externalId])
}

model NotificationPreference {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  inApp Boolean @default(true)
  email Boolean @default(true)
  telegram Boolean @default(false)
  reminder48h Boolean @default(true)
  reminder24h Boolean @default(false)
  onAssignment Boolean @default(true)
}

model NotificationLog {
  id String @id @default(cuid())
  agendaItemId String
  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id])
  recipient String
  channel NotificationChannel
  type String
  idempotencyKey String @unique
  scheduledAt DateTime
  sentAt DateTime?
  status DeliveryStatus @default(PENDING)
  safeError String?
  retryCount Int @default(0)
  @@index([status, scheduledAt])
}

model ApiSyncLog {
  id String @id @default(cuid())
  provider String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status String
  recordsUpdated Int @default(0)
  safeError String?
}
